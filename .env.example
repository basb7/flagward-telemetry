# PostgreSQL connection. Matches compose.dev.yml for local development.
DATABASE_URL=postgres://telemetry:telemetry@localhost:5433/telemetry

# Separate database for the test suite (created by `npm test` setup).
TEST_DATABASE_URL=postgres://telemetry:telemetry@localhost:5433/telemetry_test

# Host port the production container publishes on 127.0.0.1 (compose.yml).
# Nginx proxies telemetry.flagward.com to it; keep both in sync.
# TELEMETRY_PORT=3100

# Production (compose.yml): password for the stack's PostgreSQL. Required.
# POSTGRES_PASSWORD=change-me
