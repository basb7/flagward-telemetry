# Build context for the telemetry image (context: .).

# Version control
.git/
.gitignore

# Dependencies (reinstalled with `npm ci` inside the image)
node_modules/
.pnp
.pnp.*
.yarn/

# Build output (regenerated by `npm run build` inside the image)
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Secrets and local environment (DATABASE_URL comes from compose)
.env
.env.*

# Testing
coverage/

# Docker
Dockerfile
.dockerignore
compose.yml

# Documentation
*.md

# Deploy platform metadata
.vercel/

# Editors, AI tooling and OS noise
.idea/
.vscode/
.claude/
.atl/
*.pem
*.swp
*.swo
*~
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
