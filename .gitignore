# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor state (regenerated by the IDE; holds no shared project settings)
.idea/

# gentle-ai local tooling state (contains absolute paths from this machine)
.atl/

# codegraph index (per-checkout SQLite; never share between worktrees)
.codegraph/

# keep the env template tracked
!.env.example
